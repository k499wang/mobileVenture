# Public runtime values; never put server/service-role keys in EXPO_PUBLIC variables.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_APPSFLYER_DEV_KEY=
EXPO_PUBLIC_APPSFLYER_APP_ID=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
EXPO_PUBLIC_SENTRY_DSN=

# Build configuration. Use different vendor projects/keys per EAS environment.
APP_NAME=Starter
APP_SLUG=starter
APP_SCHEME=starter
APP_BUNDLE_ID=com.example.starter
APP_ANDROID_PACKAGE=com.example.starter
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN belongs in the build service's secret store, not this file.
