{
  "name": "expo-ios-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.25",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "^5.2.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.30",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.2",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-tracking-transparency": "~57.0.2",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "posthog-react-native": "^4.66.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-appsflyer": "^7.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.8.1",
    "react-native-purchases-ui": "^10.8.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:all": "npm test -- --runInBand && npm run agent:test",
    "check": "npm run typecheck && npm run lint && npm test -- --runInBand",
    "validate:release": "node scripts/validate-release.mjs",
    "eas-build-post-install": "node scripts/eas-post-install.mjs",
    "factory:create": "node factory/create-app.mjs",
    "agent:studio": "node factory/agent/cli.mjs serve",
    "agent:demo": "node factory/agent/cli.mjs run --mode demo --auto-approve --inject-failure",
    "agent:test": "node --test factory/agent/*.test.mjs factory/agent/runtime/*.test.mjs factory/agent/agents/*.test.mjs factory/agent/mcp/*.test.mjs factory/agent/creatives/*.test.mjs factory/agent/research/*.test.mjs",
    "agent:setup": "npm ci --prefix factory/agent",
    "agent:mcp": "node factory/agent/mcp/server.mjs",
    "agent:samples": "node factory/agent/cli.mjs samples",
    "agent:mcp:discover": "node factory/agent/mcp/discover.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "modulePathIgnorePatterns": [
      "<rootDir>/.agent-runs/"
    ],
    "testPathIgnorePatterns": [
      "/.agent-runs/",
      "/node_modules/",
      "/ios/"
    ]
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
